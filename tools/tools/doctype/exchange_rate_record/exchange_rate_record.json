{
 "doctype": "DocType",
 "name": "Exchange Rate Record",
 "module": "Tools",
 "autoname": "format:EXR-{#####}",
 "engine": "InnoDB",
 "track_changes": 1,
 "sort_field": "date",
 "sort_order": "DESC",
 "field_order": ["date", "from_currency", "to_currency", "exchange_rate", "source", "status", "currency_exchange", "fetched_at", "error_message"],
 "fields": [
  {"fieldname":"date","fieldtype":"Date","label":"Rate Date","reqd":1,"in_list_view":1},
  {"fieldname":"from_currency","fieldtype":"Link","label":"From Currency","options":"Currency","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"to_currency","fieldtype":"Link","label":"To Currency","options":"Currency","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"exchange_rate","fieldtype":"Float","label":"Exchange Rate","precision":"9","reqd":1,"in_list_view":1},
  {"fieldname":"source","fieldtype":"Data","label":"Source","default":"NowAPI finance.rate"},
  {"fieldname":"status","fieldtype":"Select","label":"Status","options":"Success\nFailed\nPending","default":"Success","reqd":1,"in_list_view":1,"in_standard_filter":1},
  {"fieldname":"currency_exchange","fieldtype":"Link","label":"ERPNext Currency Exchange","options":"Currency Exchange","read_only":1},
  {"fieldname":"fetched_at","fieldtype":"Datetime","label":"Fetched At","read_only":1},
  {"fieldname":"error_message","fieldtype":"Small Text","label":"Error Message","read_only":1}
 ],
 "permissions": [
  {"role":"Tools User","read":1},
  {"role":"Tools Manager","read":1,"write":1,"create":1,"delete":1,"export":1,"report":1},
  {"role":"System Manager","read":1,"write":1,"create":1,"delete":1,"export":1,"report":1}
 ]
}
